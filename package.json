{
  "name": "chinese-simplify",
  "version": "0.1.0",
  "description": "Turn comics, webtoons, and text into graded Chinese reading practice (HSK 1-6)",
  "main": "dist/index.js",
  "bin": {
    "chinese-simplify": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "cross-env UV_THREADPOOL_SIZE=24 node dist/server.js",
    "start:cli": "cross-env UV_THREADPOOL_SIZE=24 node dist/index.js",
    "dev": "cross-env UV_THREADPOOL_SIZE=24 ts-node src/index.ts",
    "dev:server": "cross-env UV_THREADPOOL_SIZE=24 ts-node src/server.ts",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "keywords": [
    "chinese",
    "mandarin",
    "hsk",
    "simplify",
    "language-learning"
  ],
  "author": "Jerry Rao",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "@node-rs/jieba": "^2.0.1",
    "@types/compression": "^1.8.1",
    "@types/multer": "^2.1.0",
    "canvas": "^3.2.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "lz-string": "^1.5.0",
    "multer": "^2.2.0",
    "opencc-js": "^1.0.5",
    "p-limit": "^7.2.0",
    "pdf-poppler": "^0.2.3",
    "pinyin-pro": "^3.28.0",
    "puppeteer": "^25.1.0",
    "segmentit": "^2.0.3",
    "sharp": "^0.34.5",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
