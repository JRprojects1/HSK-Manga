# Copy this file to .env and fill in what you need.
# Only an LLM key is required for text simplification. The image pipeline
# also needs one OCR option (an OCR server, or a Gemini/Anthropic key).

# --- Simplification (pick one provider) -----------------------------------
# Fireworks + DeepSeek V4 is what the project is tuned for: the HSK logit-bias
# maps in data/ are built for this tokenizer.
FIREWORKS_API_KEY=
SIMPLIFY_PROVIDER=fireworks
SIMPLIFY_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
ANALYSIS_PROVIDER=fireworks
ANALYSIS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Alternatives (set SIMPLIFY_PROVIDER to match):
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# QWEN_API_URL=http://localhost:1234     # local model via LM Studio / llama.cpp
# QWEN_MODEL=qwen3-8b

# --- OCR (image pipeline) --------------------------------------------------
# Self-hosted PaddleOCR (scripts/ocr-server/ocr_server.py). Comma-separate
# several URLs to load-balance.
PADDLEOCR_URLS=http://localhost:5000
# PADDLEOCR_URLS_EN=                     # optional dedicated English pool
# PADDLEOCR_URLS_KO=                     # required for Korean input (--langs ko)
# MANGAOCR_URL=

# --- Inpainting (optional; solid fill is used when off) --------------------
# ENABLE_INPAINTING=true
# INPAINTING_SERVER_URLS=http://localhost:8090

# --- Audio (optional; needs Python + edge-tts) ------------------------------
# CHAPTER_AUDIO=1

# --- Web server --------------------------------------------------------------
# PORT=3000
# LLM_DAILY_CAP_USD=5                    # stop accepting jobs past this spend
# QUOTA_DAILY_MAX=30                     # chapters per IP per day
# ACTIVE_JOB_CAP=3                       # concurrent chapters per IP
# ADMIN_TOKEN=                           # enables /admin

# Optional hosted extras — everything works without them.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# RESEND_API_KEY=                        # sign-in emails; codes print to the console when unset
# EMAIL_FROM="HSK Manga <noreply@your-domain.com>"
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
